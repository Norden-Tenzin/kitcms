{
	"name": "__APP_NAME__",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm build && wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "wrangler deploy",
		"db:generate": "kitcms migrate:create",
		"db:migrate": "kitcms migrate",
		"db:migrate:remote": "kitcms migrate --remote",
		"types": "kitcms generate:types",
		"db:seed": "kitcms seed",
		"db:seed:remote": "kitcms seed --remote"
	},
	"dependencies": {
		"@fontsource-variable/hanken-grotesk": "^5.2.0",
		"@kitcms/core": "^0.0.0",
		"@kitcms/ui": "^0.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261116.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"description": "A kitcms website: pages with blocks, a blog, team, legal pages and site settings."
}
