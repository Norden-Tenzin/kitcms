{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kitcms-playground-consumer",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Default: the CMS Worker itself (`pnpm --filter playground preview` = wrangler dev).
	"services": [
		{ "binding": "CMS", "service": "kitcms-playground", "entrypoint": "KitcmsRPC" },
		{ "binding": "SITE", "service": "kitcms-playground" },
	],
	"env": {
		// `pnpm dev:rpc` here + `pnpm --filter playground dev:rpc`: the CMS in `vite dev` with the opt-in dev
		// RPC worker, registered as `<name>-rpc` (Decision 16, packages/core/src/vite/index.ts).
		"devrpc": {
			"services": [
				{ "binding": "CMS", "service": "kitcms-playground-rpc", "entrypoint": "KitcmsRPC" },
				{ "binding": "SITE", "service": "kitcms-playground" },
			],
		},
	},
}
