{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kitcms-playground",
	// Local only: `pnpm dev` and `pnpm preview` use local D1/R2 under .wrangler/state. There is no
	// database_id, so nothing here points at a Cloudflare account. To deploy the playground to your own
	// account, see CONTRIBUTING.md.
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_als"],
	// Smart Placement runs the Worker near its D1 primary when that beats running near the visitor
	// (kitcms makes several D1 round trips per request). Combine with D1 read replication.
	"placement": { "mode": "smart" },
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kitcms-playground",
			"migrations_dir": "migrations",
		},
	],
	// Core email adapter (`email` in kitcms.config.ts). Local-safe: `wrangler dev` simulates it and
	// `vite dev` logs messages instead. Sending from a real domain needs Email Routing set up on it.
	"send_email": [{ "name": "EMAIL" }],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "kitcms-playground",
		},
	],
}
