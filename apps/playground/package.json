{
	"name": "playground",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm build && wrangler dev",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:migrate": "kitcms migrate",
		"db:generate": "kitcms migrate:create",
		"db:seed": "kitcms seed",
		"types": "kitcms generate:types",
		"dev:rpc": "KITCMS_DEV_RPC=1 CLOUDFLARE_DEV_REGISTRY_PATH=../../.dev-registry WRANGLER_REGISTRY_PATH=../../.dev-registry vite dev"
	},
	"dependencies": {
		"@kitcms/core": "workspace:*",
		"@kitcms/plugin-seo": "workspace:*",
		"@kitcms/ui": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.69.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
