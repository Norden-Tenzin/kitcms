BETTER_AUTH_SECRET=

# Cloudflare Turnstile TEST secret (always passes), paired with the test site key in
# src/lib/site/turnstile.ts. Use real keys in production (`wrangler secret put TURNSTILE_SECRET`).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Runtime plan and add-ons (plugin-entitlements). JSON on one line, in single quotes.
# Remove "offers" from addons to see the gated Offers collection and site section disappear.
KITCMS_ENTITLEMENTS='{"plan":"demo","addons":["offers"],"limits":{"documents":{"rooms":20}}}'
