{
	"name": "website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm build && wrangler dev",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "wrangler deploy",
		"db:generate": "kitcms migrate:create",
		"db:migrate": "kitcms migrate",
		"db:migrate:remote": "kitcms migrate --remote",
		"db:seed": "kitcms seed",
		"db:seed:remote": "kitcms seed --remote",
		"types": "kitcms generate:types"
	},
	"dependencies": {
		"@kitcms/core": "workspace:*",
		"@kitcms/plugin-seo": "workspace:*",
		"@kitcms/ui": "workspace:*"
	},
	"devDependencies": {
		"@shikijs/rehype": "^4.6.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.6.6",
		"gray-matter": "^4.0.3",
		"hast-util-to-string": "^3.0.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
