{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kitcms-website",
	// Local dev and `pnpm preview` use local D1/R2 under .wrangler/state. There is no database_id and no
	// account_id, so nothing here points at a Cloudflare account. Deployed by Workers Builds (Cloudflare's
	// Git integration, Decision 44): the first `wrangler deploy` creates the D1 database and R2 bucket from
	// the names below, later deploys reuse them. The custom domain (kitcms.dev) is attached after the first
	// admin has signed up on the workers.dev URL (plan §18.6).
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_als"],
	// Smart Placement runs the Worker near its D1 primary when that beats running near the visitor
	// (kitcms makes several D1 round trips per request). Combine with D1 read replication.
	"placement": { "mode": "smart" },
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kitcms-website",
			"migrations_dir": "migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "kitcms-website",
		},
	],
}
