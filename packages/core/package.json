{
	"name": "@kitcms/core",
	"version": "0.1.3",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Norden-Tenzin/kitcms.git",
		"directory": "packages/core"
	},
	"homepage": "https://kitcms.dev",
	"bugs": {
		"url": "https://github.com/Norden-Tenzin/kitcms/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./sveltekit": {
			"types": "./src/sveltekit/index.ts",
			"default": "./src/sveltekit/index.ts"
		},
		"./rpc": {
			"types": "./src/rpc/index.ts",
			"default": "./src/rpc/index.ts"
		},
		"./sveltekit/admin": {
			"types": "./src/sveltekit/admin.ts",
			"default": "./src/sveltekit/admin.ts"
		},
		"./client": {
			"types": "./src/client.ts",
			"default": "./src/client.ts"
		},
		"./sveltekit/api": {
			"types": "./src/sveltekit/api.ts",
			"default": "./src/sveltekit/api.ts"
		},
		"./richtext": {
			"types": "./src/richtext/index.ts",
			"default": "./src/richtext/index.ts"
		},
		"./vite": {
			"types": "./src/vite/index.ts",
			"default": "./src/vite/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit && tsc -p test/tsconfig.json && tsc -p src/cli/cli.tsconfig.json && tsc -p src/vite/tsconfig.json",
		"build:vite": "tsc -p src/vite/tsconfig.build.json",
		"prepack": "pnpm build:vite"
	},
	"bin": {
		"kitcms": "./bin/kitcms.js"
	},
	"files": [
		"src",
		"bin",
		"dist",
		"!src/**/*.test.ts"
	],
	"peerDependencies": {
		"@sveltejs/adapter-cloudflare": "^8",
		"@sveltejs/kit": "^3",
		"@sveltejs/vite-plugin-svelte": "^7",
		"vite": "^8",
		"wrangler": "^4",
		"@cloudflare/vite-plugin": "^1.69.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.69.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"miniflare": "5.20261113.0-beta",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	},
	"dependencies": {
		"better-auth": "^1.7.25",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4"
	},
	"peerDependenciesMeta": {
		"wrangler": {
			"optional": true
		},
		"@cloudflare/vite-plugin": {
			"optional": true
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./src/index.ts",
				"default": "./src/index.ts"
			},
			"./sveltekit": {
				"types": "./src/sveltekit/index.ts",
				"default": "./src/sveltekit/index.ts"
			},
			"./rpc": {
				"types": "./src/rpc/index.ts",
				"default": "./src/rpc/index.ts"
			},
			"./sveltekit/admin": {
				"types": "./src/sveltekit/admin.ts",
				"default": "./src/sveltekit/admin.ts"
			},
			"./client": {
				"types": "./src/client.ts",
				"default": "./src/client.ts"
			},
			"./sveltekit/api": {
				"types": "./src/sveltekit/api.ts",
				"default": "./src/sveltekit/api.ts"
			},
			"./richtext": {
				"types": "./src/richtext/index.ts",
				"default": "./src/richtext/index.ts"
			},
			"./vite": {
				"types": "./dist/vite/index.d.ts",
				"default": "./dist/vite/index.js"
			}
		}
	}
}
