{
	"name": "@kitcms/core",
	"version": "0.0.0",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./sveltekit": {
			"types": "./src/sveltekit/index.ts",
			"default": "./src/sveltekit/index.ts"
		},
		"./rpc": {
			"types": "./src/rpc/index.ts",
			"default": "./src/rpc/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"bin": {
		"kitcms": "./bin/kitcms.js"
	},
	"files": [
		"src",
		"bin"
	]
}
