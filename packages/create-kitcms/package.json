{
	"name": "create-kitcms",
	"version": "0.0.0",
	"description": "Scaffold a kitcms app: pnpm create kitcms",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"prepack": "node scripts/copy-templates.js && pnpm build"
	},
	"bin": {
		"create-kitcms": "./bin/create.js"
	},
	"files": [
		"bin",
		"dist",
		"templates"
	],
	"devDependencies": {
		"@types/node": "^26.6.6"
	}
}
