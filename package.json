{
	"name": "kitcms-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter playground dev",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "pnpm --filter e2e test",
		"changeset": "changeset",
		"bench:bundle": "node scripts/bench/bundle-size.ts",
		"smoke:npm": "node scripts/smoke-npm.mjs"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@cloudflare/workers-types": "^5.20261116.1",
		"@eslint/js": "^10.0.1",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	}
}
